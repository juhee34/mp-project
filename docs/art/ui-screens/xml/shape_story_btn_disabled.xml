<?xml version="1.0" encoding="utf-8"?>
<!-- ui_story_btn_disabled: fill #E2D5C9, stroke #A59B99 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CFC3B8" />
            <stroke android:width="2dp" android:color="#A59B99" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E2D5C9" />
            <stroke android:width="2dp" android:color="#A59B99" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
