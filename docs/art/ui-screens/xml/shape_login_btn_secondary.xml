<?xml version="1.0" encoding="utf-8"?>
<!-- ui_login_btn_secondary: fill #FDEACB, stroke #043E16 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8D7BA" />
            <stroke android:width="2dp" android:color="#043E16" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDEACB" />
            <stroke android:width="2dp" android:color="#043E16" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
