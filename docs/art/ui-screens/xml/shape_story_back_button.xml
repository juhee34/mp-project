<?xml version="1.0" encoding="utf-8"?>
<!-- ui_story_back_button: fill #0B5015, stroke #6D3000 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0A4913" />
            <stroke android:width="10dp" android:color="#6D3000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B5015" />
            <stroke android:width="10dp" android:color="#6D3000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
