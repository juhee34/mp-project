<?xml version="1.0" encoding="utf-8"?>
<!-- ui_story_counter_pill: fill #FCE5B9, stroke #672C00 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E7D2AA" />
            <stroke android:width="2dp" android:color="#672C00" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FCE5B9" />
            <stroke android:width="2dp" android:color="#672C00" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
