<?xml version="1.0" encoding="utf-8"?>
<!-- ui_story_btn_outline: fill #FDEDCE, stroke #00320F (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8DABD" />
            <stroke android:width="2dp" android:color="#00320F" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDEDCE" />
            <stroke android:width="2dp" android:color="#00320F" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
