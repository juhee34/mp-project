<?xml version="1.0" encoding="utf-8"?>
<!-- ui_menu_btn_primary: fill #164F19, stroke #134B16 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#144817" />
            <stroke android:width="2dp" android:color="#134B16" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#164F19" />
            <stroke android:width="2dp" android:color="#134B16" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
