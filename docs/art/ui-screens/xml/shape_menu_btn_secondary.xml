<?xml version="1.0" encoding="utf-8"?>
<!-- ui_menu_btn_secondary: fill #FDEBCA, stroke #03360F (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8D8B9" />
            <stroke android:width="2dp" android:color="#03360F" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDEBCA" />
            <stroke android:width="2dp" android:color="#03360F" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
