<?xml version="1.0" encoding="utf-8"?>
<!-- ui_story_count_pill: fill #DBBDEB, stroke #D5BCE8 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C9ADD8" />
            <stroke android:width="2dp" android:color="#D5BCE8" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DBBDEB" />
            <stroke android:width="2dp" android:color="#D5BCE8" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
