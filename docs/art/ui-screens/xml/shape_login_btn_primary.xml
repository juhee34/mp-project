<?xml version="1.0" encoding="utf-8"?>
<!-- ui_login_btn_primary: fill #115519, stroke #105519 (from the approved mockup). Pressed state darkens ~8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0F4E17" />
            <stroke android:width="2dp" android:color="#105519" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#115519" />
            <stroke android:width="2dp" android:color="#105519" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
