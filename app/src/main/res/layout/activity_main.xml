<?xml version="1.0" encoding="utf-8"?>
<!-- The opening's sky, clouds and hills sit behind the menu and the character screens (ui/Scenery.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6EC">

    <com.tinyrunners.school.ui.SceneryView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- B-owned menu: records and settings stay one tap away from every character screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp">

            <!-- Coin balance (the metres-per-coin rule lives in shop/ShopRules); tapping it opens the shop. -->
            <TextView
                android:id="@+id/coin_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/coin_badge_loading"
                android:textColor="#8C6014"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/menu_shop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/menu_shop"
                android:textAllCaps="false"
                android:textColor="#8C6014"
                android:textStyle="bold" />

            <Button
                android:id="@+id/menu_stories"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/menu_stories"
                android:textAllCaps="false"
                android:textColor="#305341" />

            <Button
                android:id="@+id/menu_records"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/menu_records"
                android:textAllCaps="false"
                android:textColor="#305341" />

            <Button
                android:id="@+id/menu_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/menu_settings"
                android:textAllCaps="false"
                android:textColor="#305341" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/screen_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
