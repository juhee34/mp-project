<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: the friend on the left; name, weather, their word and the game's name on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <ImageView android:id="@+id/widget_friend"
        android:layout_width="84dp" android:layout_height="84dp"
        android:background="@drawable/widget_friend_bg" android:padding="3dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_friend" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_name" android:text="@string/widget_preview_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#1E5A2A" android:textSize="16sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_weather" android:text="@string/widget_preview_weather"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#7A6E5E" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_line" android:text="@string/widget_preview_line"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#3D3550" android:textSize="13sp"
            android:maxLines="2" android:ellipsize="end" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/app_name"
            android:textColor="#C9A26A" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
