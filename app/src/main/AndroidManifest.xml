<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase Authentication/Firestore and the Open-Meteo weather request. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name" android:theme="@style/AppTheme" android:supportsRtl="true">
        <activity android:name=".game.GameActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <!-- Login and sign-up open as popups over the opening. -->
        <activity android:name=".auth.LoginActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:theme="@style/AuthPopupTheme" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".auth.SignupActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:theme="@style/AuthPopupTheme" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".result.ResultActivity" android:exported="false" />
        <activity android:name=".records.RecordsActivity" android:exported="false" />
        <activity android:name=".stories.StoryActivity" android:exported="false" />
        <activity android:name=".settings.SettingsActivity" android:exported="false" />
        <activity android:name=".story.StoryListActivity" android:exported="false" />
        <activity android:name=".story.StoryActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <!-- Landscape title screen on every launch; the friend designs it, the button sits in the centre. -->
        <activity android:name=".opening.OpeningActivity" android:exported="true" android:screenOrientation="sensorLandscape" android:theme="@style/OpeningTheme">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
